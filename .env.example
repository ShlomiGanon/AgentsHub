# AgentsHub environment template. Copy to `.env` and fill in real values.
# See docs/operator_guide.md for the full setup walkthrough.
# Running tests? Not this file — set TEST_-prefixed equivalents instead (conftest.py's test_env fixture; see docs/profile_spec.md).

# Telegram bot token
BOT_TOKEN=000000000:AAFakeExampleTokenNotReal00000000000

# Shared secret the bot must present (as X-Service-Key) whenever it calls the API as its own
# bot-service identity — separate from any human's Telegram identity, and required because
# "bot-service" itself is a fixed, public string, not a secret. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_KEY=fake-example-bot-service-key-not-real-00000000

# Core tier — provider and model
CORE_MODEL_PROVIDER=openrouter
CORE_MODEL_NAME=anthropic/claude-3.5-sonnet

# Core tier — API key env var name, and the key itself
CORE_MODEL_API_KEY_ENV=CORE_MODEL_KEY
CORE_MODEL_KEY=sk-or-v1-fakeExampleCoreTierKey0000000000000000000000

# Sub tier — provider and model
SUB_MODEL_PROVIDER=openrouter
SUB_MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

# Sub tier — API key env var name, and the key itself
SUB_MODEL_API_KEY_ENV=SUB_MODEL_KEY
SUB_MODEL_KEY=sk-or-v1-fakeExampleSubTierKey00000000000000000000000

# Verbose diagnostic logging (off by default)
DEBUG_VERBOSE_LOGGING=false

# Commander-only live route trace and raw model-I/O persistence. Keep false
# except during a bounded diagnostic session; changing it requires restart.
DEEP_DEBUG=false

# Raw JSON log stream on stdout, alongside the human-readable one on
# stderr (on by default — set to false/0 for a terminal with only the
# human-readable lines; the DB log sink is unaffected either way)
LOG_CONSOLE_JSON=true

# Optional — OpenRouter overrides, safe to leave unset
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OR_SITE_URL=https://example.com
# OR_APP_NAME=AgentsHub
